APP_NAME="Trading API"
API_VERSION="1.0.0"
ENVIRONMENT="local"

# Source data
GOOGLE_SHEET_ID="1o1exoHTCrfG45V-mLuaDNPhMt_yWwAuGl06bLZYD_Kk"
USE_PUBLIC_GOOGLE_SHEET="true"
LOCAL_INPUT_XLSX="data/trading.xlsx"

# Security
REFRESH_TOKEN="change-this-to-a-long-random-secret"

# Cache behavior: first request after TTL refreshes; repeated requests within TTL use cache.
CACHE_FILE="/tmp/trading_api_cache.json"
CACHE_TTL_SECONDS="3600"
AUTO_REFRESH_WHEN_EMPTY="true"
AUTO_REFRESH_WHEN_STALE="true"

# Cloud Run persistent cache. Leave blank for local Docker testing.
GCS_CACHE_BUCKET=""
GCS_CACHE_BLOB="cache/trading_api_cache.json"

# CORS. Use * locally. In production, prefer your trading frontend/API domains.
ALLOWED_ORIGINS="*"

# Runtime behavior
REQUEST_SLEEP_SECONDS="0.25"
EXPORT_OUTPUT_DIR="outputs"
